# ==============================================================================
# Tarmeem (ترميم) — Environment Variables Template
# Copy this file to .env or pass values via flutter run --dart-define
# ==============================================================================

# Supabase Storage & Cloud Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_BUCKET=ticket-images

# Firebase Keys (Optional override via --dart-define)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_ANDROID_API_KEY=your-firebase-android-api-key
FIREBASE_IOS_API_KEY=your-firebase-ios-api-key
FIREBASE_WINDOWS_API_KEY=your-firebase-windows-api-key
